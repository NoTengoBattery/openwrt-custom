. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
gemtek,w1700k-ubi)
	ucidef_set_led_netdev "wan-green" "wan" "mt7530-0:08:green:wan" "wan" "link_2500 link_5000 link_10000 tx rx"
	ucidef_set_led_netdev "wan-yellow" "wan" "mt7530-0:08:yellow:wan" "wan" "link_10 link_100 link_1000"
	ucidef_set_led_netdev "lan2-green" "lan2" "mt7530-0:05:green:lan-2" "lan2" "link_2500 link_5000 link_10000 tx rx"
	ucidef_set_led_netdev "lan2-yellow" "lan2" "mt7530-0:05:yellow:lan-2" "lan2" "link_10 link_100 link_1000"
	ucidef_set_led_netdev "lan3-yellow" "lan3" "yellow:lan-3" "lan3" "link_10 link_100"
	ucidef_set_led_netdev "lan3-green" "lan3" "green:lan-3" "lan3" "link_1000 tx rx"
	ucidef_set_led_netdev "lan4-yellow" "lan4" "yellow:lan-4" "lan4" "link_10 link_100"
	ucidef_set_led_netdev "lan4-green" "lan4" "green:lan-4" "lan4" "link_1000 tx rx"
	;;
esac

board_config_flush

exit 0
