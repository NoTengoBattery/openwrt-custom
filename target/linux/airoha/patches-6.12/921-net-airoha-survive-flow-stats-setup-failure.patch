From: Oever Gonzalez <software@notengobattery.com>
Subject: [PATCH] net: airoha: survive PPE flow stats setup failure

airoha_ppe_offload_setup() treats a failed FLOW_STATS_SETUP NPU
mailbox op as fatal: the NPU is released and all hardware offload is
lost, silently. Firmware builds exist that don't implement the op
(the wifi-flavored en7581 firmware among them), so
CONFIG_NET_AIROHA_FLOW_STATS=y (the default) quietly disables the PPE
on those devices.

Degrade instead of dying: log the errno and continue without hw flow
counters. npu->stats stays NULL, so gate every consumer on it - the
per-index reset, the flow stats update, and the FLOW_CLS_STATS reader.
Also reject a zero stats address, which firmware can return while
acking the op without implementing it.

Without counters, FLOW_CLS_STATS reports zero bytes and packets.
Idle detection is unaffected: the driver fills lastused from the
PPE bind timestamp, which does not depend on the stats table.

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -451,6 +451,11 @@
 	if (err)
 		goto out;
 
+	if (!ppe_data->stats_info.npu_stats_addr) {
+		err = -ENODATA;
+		goto out;
+	}
+
 	npu->stats = devm_ioremap(npu->dev,
 				  ppe_data->stats_info.npu_stats_addr,
 				  size);
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -563,6 +563,9 @@
 						 struct airoha_npu *npu,
 						 int index)
 {
+	if (!npu->stats)
+		return;
+
 	memset_io(&npu->stats[index], 0, sizeof(*npu->stats));
 	memset(&ppe->foe_stats[index], 0, sizeof(*ppe->foe_stats));
 }
@@ -590,6 +593,9 @@
 	int ppe_num_stats_entries;
 	u8 nbq;
 
+	if (!npu->stats)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
@@ -1413,7 +1419,7 @@
 	rcu_read_lock();
 
 	npu = rcu_dereference(eth->npu);
-	if (npu) {
+	if (npu && npu->stats) {
 		u64 packets = ppe->foe_stats[index].packets;
 		u64 bytes = ppe->foe_stats[index].bytes;
 		struct airoha_foe_stats npu_stats;
@@ -1545,8 +1551,11 @@
 	if (ppe_num_stats_entries > 0) {
 		err = npu->ops.ppe_init_stats(npu, ppe->foe_stats_dma,
 					      ppe_num_stats_entries);
+		/* some firmware lacks this op; don't lose offload over it */
 		if (err)
-			goto error_npu_put;
+			dev_warn(eth->dev,
+				 "PPE flow stats setup failed (%d), continuing without hw flow counters\n",
+				 err);
 	}
 
 	airoha_ppe_hw_init(ppe);
