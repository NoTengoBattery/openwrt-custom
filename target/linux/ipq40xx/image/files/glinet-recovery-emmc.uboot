    fi
    imxtract $imgaddr rootfs || setenv stdout serial && echo "$failedmsg" && exit 1
    mmc erase 0x10022 0x40000 || setenv stdout serial && echo "$failedmsg" && exit 1
    mmc write $fileaddr 0x10022 __ROOTFS_BLKCNT__ || setenv stdout serial && echo "$failedmsg" && exit 1
    if test "x$verbose" = "x"; then
        setenv stdout serial
        echo '[ done ]'
        setenv stdout nulldev
        setenv stdout serial
    else
        echo '######################################## Flashing rootfs: Done'
    fi
    if test "x$verbose" = "x"; then
        echo \\c'Flashing rootfs_data:                   '
        setenv stdout nulldev
    else
        echo '######################################## Flashing rootfs_data: Started'
    fi
    mmc erase 0x50022 0x100000 || setenv stdout serial && echo "$failedmsg" && exit 1
    imxtract $imgaddr rootfs_data || setenv stdout serial && echo "$failedmsg" && exit 1
    mmc write $fileaddr 0x50022 __ROOTFS_DATA_BLKCNT__ || setenv stdout serial && echo "$failedmsg" && exit 1
    if test "x$verbose" = "x"; then
        setenv stdout serial
        echo '[ done ]'
        setenv stdout nulldev
        setenv stdout serial
    else
        echo '######################################## Flashing rootfs_data: Done'
    fi
    exit 0

fi
