From: Oever Gonzalez <software@notengobattery.com>
Subject: [PATCH] mt7996: notify the airoha PPE on STA association events

The airoha PPE caches the WDMA wcid inside installed bridge flows; a
STA reassociation changes the wcid with no FDB churn, leaving the
cached copy pointing at a dead entry (frozen-wcid blackhole). Forward
STA assoc/authorize/disassoc events through the airoha_ppe_dev handle
so the PPE can re-resolve its cached templates.

Also restore wcid.sta/sta_disabled in the ASSOC handler: a
reassociation that never dropped to NOTEXIST skips
mt7996_mac_sta_init_link (the only place wcid.sta is set), so after
MT76_STA_EVENT_DISASSOC clears it, mt7996_net_fill_forward_path
returns -EIO for that STA forever and offload can never re-engage.
A fresh add reaches ASSOC with wcid.sta already 1, so this converges
both paths to the same state.

diff --color -ur a/mt76.h b/mt76.h
--- a/mt76.h
+++ b/mt76.h
@@ -1683,6 +1683,7 @@
 int mt76_npu_send_txrx_addr(struct mt76_dev *dev, int ifindex,
 			    u32 direction, u32 i_count_addr,
 			    u32 o_status_addr, u32 o_count_addr);
+void mt76_npu_sta_notify(struct mt76_dev *dev, const u8 *addr);
 #else
 static inline void mt76_npu_check_ppe(struct mt76_dev *dev,
 				      struct sk_buff *skb, u32 info)
@@ -1748,6 +1749,10 @@
 {
 	return -EOPNOTSUPP;
 }
+
+static inline void mt76_npu_sta_notify(struct mt76_dev *dev, const u8 *addr)
+{
+}
 #endif /* CONFIG_MT76_NPU */
 
 static inline bool mt76_npu_device_active(struct mt76_dev *dev)
diff --color -ur a/mt7996/main.c b/mt7996/main.c
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1405,6 +1405,13 @@
 				goto unlock;
 
 			msta_link->wcid.tx_info |= MT_WCID_TX_INFO_SET;
+			/* a reassoc that never dropped to NOTEXIST skips
+			 * mt7996_mac_sta_init_link; restore the flags
+			 * MT76_STA_EVENT_DISASSOC cleared or
+			 * net_fill_forward_path stays -EIO forever
+			 */
+			msta_link->wcid.sta = 1;
+			msta_link->wcid.sta_disabled = 0;
 			break;
 		case MT76_STA_EVENT_AUTHORIZE:
 			err = mt7996_mcu_add_sta(dev, link_conf, link_sta,
@@ -1434,6 +1441,10 @@
 unlock:
 	mutex_unlock(&dev->mt76.mutex);
 
+	if (ev == MT76_STA_EVENT_ASSOC || ev == MT76_STA_EVENT_AUTHORIZE ||
+	    ev == MT76_STA_EVENT_DISASSOC)
+		mt76_npu_sta_notify(&dev->mt76, sta->addr);
+
 	return err;
 }
 
diff --color -ur a/npu.c b/npu.c
--- a/npu.c
+++ b/npu.c
@@ -383,6 +383,21 @@
 }
 EXPORT_SYMBOL_GPL(mt76_npu_net_setup_tc);
 
+/* The PPE caches the wcid inside installed bridge flows; tell it to
+ * re-resolve whenever a STA (re)associates or goes away.
+ */
+void mt76_npu_sta_notify(struct mt76_dev *dev, const u8 *addr)
+{
+	struct airoha_ppe_dev *ppe_dev;
+
+	rcu_read_lock();
+	ppe_dev = rcu_dereference(dev->mmio.ppe_dev);
+	if (ppe_dev)
+		airoha_ppe_dev_sta_notify(ppe_dev, addr);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(mt76_npu_sta_notify);
+
 int mt76_npu_send_txrx_addr(struct mt76_dev *dev, int ifindex,
 			    u32 direction, u32 i_count_addr,
 			    u32 o_status_addr, u32 o_count_addr)
