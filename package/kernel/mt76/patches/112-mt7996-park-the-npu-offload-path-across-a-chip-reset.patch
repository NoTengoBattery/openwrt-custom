From: Oever Gonzalez <software@notengobattery.com>
Subject: [PATCH] mt7996: park the NPU offload path across a chip reset

Everything mt7996_mac_restart() stops before resetting the chip is on
the host side: the tx worker, the NAPIs, the mac80211 queues. Offloaded
flows do not go through any of them -- they run PPE to NPU to chip
without the host in the path -- so they are still being handed to the
wireless side while it is held in reset. That is why a module reload
needs "wifi down" first to be clean: bringing the interfaces down is
what stops the traffic at its source.

The reset path has no interfaces to bring down, but the NPU has a knob
for exactly this. WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU is sent once at
probe, as zero, from airoha_npu_wlan_init_reserved_memory(); setting it
routes frames to the host instead of the offload handoff. Measured on a
W1700K across a full reset: the NPU's enqueue counter keeps climbing
while its hand-off counter stops dead and neither error counter moves,
so frames are held rather than dropped.

Assert it before the reset. The pool rebuild clears it again as its own
last step, which is too early -- the ring addresses are not bound yet --
so re-assert it across the rebind and clear it exactly once, at the end,
and only if the rebind succeeded. A failed rebind therefore leaves
offload parked rather than pointed at rings that were never programmed.

--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -513,6 +513,28 @@
 				      &dev->mt76.q_rx[MT_RXQ_NPU1]);
 }
 
+static int mt7996_npu_force_to_cpu(struct mt7996_dev *dev, u32 on)
+{
+	struct airoha_npu *npu;
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu, &dev->mt76.mutex);
+	if (!npu)
+		return 0;
+
+	return mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU,
+				 on, GFP_KERNEL);
+}
+
+int __mt7996_npu_park(struct mt7996_dev *dev)
+{
+	return mt7996_npu_force_to_cpu(dev, 1);
+}
+
+int __mt7996_npu_unpark(struct mt7996_dev *dev)
+{
+	return mt7996_npu_force_to_cpu(dev, 0);
+}
+
 int __mt7996_npu_mem_reinit(struct mt7996_dev *dev)
 {
 	struct airoha_npu *npu;
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -1006,6 +1006,8 @@
 #ifdef CONFIG_MT7996_NPU
 int __mt7996_npu_hw_init(struct mt7996_dev *dev);
 int __mt7996_npu_mem_reinit(struct mt7996_dev *dev);
+int __mt7996_npu_park(struct mt7996_dev *dev);
+int __mt7996_npu_unpark(struct mt7996_dev *dev);
 int mt7996_npu_hw_init(struct mt7996_dev *dev);
 int mt7996_npu_hw_stop(struct mt7996_dev *dev);
 int mt7996_npu_rx_queues_init(struct mt7996_dev *dev);
@@ -1019,6 +1021,16 @@
 {
 	return 0;
 }
+
+static inline int __mt7996_npu_park(struct mt7996_dev *dev)
+{
+	return 0;
+}
+
+static inline int __mt7996_npu_unpark(struct mt7996_dev *dev)
+{
+	return 0;
+}
 
 static inline int mt7996_npu_hw_init(struct mt7996_dev *dev)
 {
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2330,6 +2330,13 @@
 	mt7996_tx_token_put(dev);
 	idr_init(&dev->mt76.token);
 
+	/* offloaded flows bypass every host queue stopped above: only the NPU
+	 * itself can hold them off while the wireless side is in reset
+	 */
+	err = __mt7996_npu_park(dev);
+	if (err)
+		dev_err(dev->mt76.dev, "npu park failed: %d\n", err);
+
 	mt7996_dma_reset(dev, true);
 
 	mt76_for_each_q_rx(mdev, i) {
@@ -2371,10 +2378,17 @@
 	if (err)
 		dev_err(dev->mt76.dev, "npu memory re-init failed: %d\n", err);
 
+	/* mem_reinit clears the park as its own last step; re-assert it or the
+	 * NPU resumes into rings that have not been bound yet
+	 */
+	__mt7996_npu_park(dev);
+
 	/* the NPU still points at rings this reset invalidated */
 	err = __mt7996_npu_hw_init(dev);
 	if (err)
 		dev_err(dev->mt76.dev, "npu offload rebind failed: %d\n", err);
+	else
+		__mt7996_npu_unpark(dev);
 
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
 	    mt7996_has_hwrro(dev)) {
