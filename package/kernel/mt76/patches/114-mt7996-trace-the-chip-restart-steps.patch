From: Oever Gonzalez <software@notengobattery.com>
Subject: [PATCH] mt7996: trace the chip restart steps

The restart sequence fails inside a few hundred milliseconds and the
first thing the log shows is a PCIe completion timeout, which says
nothing about which step provoked it. Name each step as it starts.

Diagnostic scaffolding, not for upstream.

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2333,6 +2333,7 @@
 	/* offloaded flows bypass every host queue stopped above: only the NPU
 	 * itself can hold them off while the wireless side is in reset
 	 */
+	dev_info(dev->mt76.dev, "restart: %s\n", "park");
 	err = __mt7996_npu_park(dev);
 	if (err)
 		dev_err(dev->mt76.dev, "npu park failed: %d\n", err);
@@ -2340,10 +2341,12 @@
 	/* the wfsys reset below takes the chip out from under the NPU: the
 	 * reload survives it only because it unbinds the NPU first
 	 */
+	dev_info(dev->mt76.dev, "restart: %s\n", "detach");
 	err = __mt7996_npu_detach(dev);
 	if (err)
 		dev_err(dev->mt76.dev, "npu detach failed: %d\n", err);
 
+	dev_info(dev->mt76.dev, "restart: %s\n", "dma_reset");
 	mt7996_dma_reset(dev, true);
 
 	mt76_for_each_q_rx(mdev, i) {
@@ -2374,6 +2377,7 @@
 	}
 
 	/* load firmware */
+	dev_info(dev->mt76.dev, "restart: %s\n", "firmware");
 	ret = mt7996_mcu_init_firmware(dev);
 	if (ret)
 		goto out;
@@ -2381,6 +2385,7 @@
 	/* rebuild the pools only once the chip can answer again: probe does
 	 * this against a live wireless side and nothing else ever issues it
 	 */
+	dev_info(dev->mt76.dev, "restart: %s\n", "mem_reinit");
 	err = __mt7996_npu_mem_reinit(dev);
 	if (err)
 		dev_err(dev->mt76.dev, "npu memory re-init failed: %d\n", err);
@@ -2391,6 +2396,7 @@
 	__mt7996_npu_park(dev);
 
 	/* the NPU still points at rings this reset invalidated */
+	dev_info(dev->mt76.dev, "restart: %s\n", "rebind");
 	err = __mt7996_npu_hw_init(dev);
 	if (err)
 		dev_err(dev->mt76.dev, "npu offload rebind failed: %d\n", err);
