From: Oever Gonzalez <software@notengobattery.com>
Subject: [PATCH] mt7996: expose the NPU offload steps individually

When the offload handoff wedges, the only thing that recovers it is a
module reload, and the only thing that reproduces a reload in place is a
full chip reset -- which bundles a wfsys reset, a WFDMA reset, a
firmware download and four separate NPU operations into one event. If it
fails, nothing says which part mattered, and if it fails badly the chip
needs a power cycle. That is the wrong instrument for finding out which
step actually unblocks the pipe.

Expose the steps one at a time. Four of the five are mailbox messages
that touch no chip register: parking and unparking the handoff, revoking
the inode's txrx register binding, and rebuilding the NPU's buffer pools
from the reserved-memory bases. The fifth reprograms ring descriptor
bases through writel() and is the one that must not run against a live
DMA engine.

Rebuilding the pools is the step a module reload performs and no
in-place path ever does, so it is the first one worth trying against a
wedged pipe -- and it can now be tried without resetting anything.

Write-only, one step per write, result in the log.

--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -46,6 +46,50 @@
 DEFINE_DEBUGFS_ATTRIBUTE(fops_implicit_txbf, mt7996_implicit_txbf_get,
 			 mt7996_implicit_txbf_set, "%lld\n");
 
+/* One offload step per write, so a wedge can be bisected instead of reset:
+ * 1 park, 2 unpark, 3 detach, 4 rebuild pools, 5 rebind rings.
+ * Only 5 writes chip registers -- it reprograms ring bases under a live
+ * DMA engine, which is what killed the chip when it ran unbisected.
+ */
+static int
+mt7996_npu_step_set(void *data, u64 val)
+{
+	struct mt7996_dev *dev = data;
+	int err;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return -ENODEV;
+
+	mutex_lock(&dev->mt76.mutex);
+	switch (val) {
+	case 1:
+		err = __mt7996_npu_park(dev);
+		break;
+	case 2:
+		err = __mt7996_npu_unpark(dev);
+		break;
+	case 3:
+		err = __mt7996_npu_detach(dev);
+		break;
+	case 4:
+		err = __mt7996_npu_mem_reinit(dev);
+		break;
+	case 5:
+		err = __mt7996_npu_hw_init(dev);
+		break;
+	default:
+		err = -EINVAL;
+		break;
+	}
+	mutex_unlock(&dev->mt76.mutex);
+
+	dev_info(dev->mt76.dev, "npu step %llu: %d\n", val, err);
+
+	return err;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(fops_npu_step, NULL, mt7996_npu_step_set, "%llu\n");
+
 static int mt7996_npu_stats(struct seq_file *s, void *data)
 {
 	static const struct {
@@ -973,6 +1017,7 @@
 				    mt7996_twt_stats);
 	debugfs_create_devm_seqfile(dev->mt76.dev, "npu_stats", dir,
 				    mt7996_npu_stats);
+	debugfs_create_file("npu_step", 0200, dir, dev, &fops_npu_step);
 	debugfs_create_file("rf_regval", 0600, dir, dev, &fops_rf_regval);
 	debugfs_create_file("vow_atf", 0600, dir, dev, &fops_vow_atf);
 
