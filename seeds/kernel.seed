# Customization of kernel build config for all targets

CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_BLK_DEV_DM=m
CONFIG_BLK_DEV_SD=y
CONFIG_DM_BUFIO=m
CONFIG_DM_DEBUG_BLOCK_MANAGER_LOCKING=n
CONFIG_FRONTSWAP=y
CONFIG_KERNEL_BUILD_DOMAIN="notengobattery.com"
CONFIG_KERNEL_BUILD_USER="software"
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MD=y
CONFIG_SCSI=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT="zstd"
CONFIG_ZSWAP_ZPOOL_DEFAULT="z3fold"
CONFIG_ZSWAP=y
