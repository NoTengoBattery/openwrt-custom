# Customization of build config for RAMIPS

CONFIG_TARGET_ramips=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_VERSION_MANUFACTURER_URL="https://www.mediatek.com"
CONFIG_VERSION_MANUFACTURER="MediaTek"
CONFIG_VERSION_PRODUCT="Ramips"

# Subtargets ship wpad-basic-mbedtls in DEFAULT_PACKAGES; opt out explicitly.
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mbedtls=y
