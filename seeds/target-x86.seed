# Customization of build config for Intel x86 (Machine Specific)

CONFIG_TARGET_x86=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=16

CONFIG_BUSYBOX_CONFIG_ACPID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_ACPID_COMPAT=y
CONFIG_PACKAGE_i915-firmware-dmc=y
CONFIG_PACKAGE_i915-firmware-gsc=y
CONFIG_PACKAGE_i915-firmware-guc=y
CONFIG_PACKAGE_i915-firmware-huc=y
CONFIG_PACKAGE_i915-firmware=y
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_iucode-tool=y

CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-dm-integrity=y
CONFIG_PACKAGE_kmod-dm-raid=y
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_kmod-fs-efivarfs=y
CONFIG_PACKAGE_kmod-i2c-smbus=y
CONFIG_PACKAGE_kmod-kvm-intel=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-pcspkr=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_kmod-sound-hda-core=y
CONFIG_PACKAGE_kmod-sound-hda-intel=y

CONFIG_BUSYBOX_CONFIG_BEEP=n
CONFIG_PACKAGE_beep=y
CONFIG_PACKAGE_efibootmgr=y
CONFIG_PACKAGE_efivar=y

# Promoted from available to included
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-app-modemdata=y
CONFIG_PACKAGE_luci-app-qfirehose=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-sms-manager=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_powertop=y

CONFIG_PACKAGE_dropbear=n
CONFIG_PACKAGE_openssh-client-utils=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-moduli=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_openssh-sftp-server=y

CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_jq-full=y
CONFIG_PACKAGE_kopia=y
CONFIG_PACKAGE_netifyd=y
CONFIG_PACKAGE_socat=y

CONFIG_GRUB_TIMEOUT="1"
CONFIG_GRUB_TITLE="NoTengoBattery OpenWrt"

CONFIG_VERSION_MANUFACTURER_URL="https://www.intel.com/"
CONFIG_VERSION_MANUFACTURER="Intel"
CONFIG_VERSION_PRODUCT="Intel Alder Lake"

CONFIG_USES_EXT4=n
CONFIG_TARGET_ROOTFS_EXT4FS=n