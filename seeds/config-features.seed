# SCOPE: all targets, all size tiers        LEVEL: =y only
#
# Cross-target capability that has to be in the image at boot. Anything
# that only needs to be installable belongs in config-available.seed (=m).
# Packages already forced by a ../feed DEPENDS must not be listed here.
# See README.md.

CONFIG_INCLUDE_CONFIG=y

CONFIG_KERNEL_TASKSTATS=y

CONFIG_AFALG_DIGESTS=y
CONFIG_AFALG_UPDATE_CTR_IV=y
CONFIG_AFALG_ZERO_COPY=y

CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-veth=y

# USB block storage; vfat/ext4 baked in, the rest in packages-full.seed.
# exfat arrives via the notengobattery-defaults DEPENDS.
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage=y

# flower + act-vlan feed hardware offload (PPE on airoha); bridger
# automates FDB-snooped rules on top, with an eBPF fallback.
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-flower=y

# USB net/serial drivers; the cellular modem suite is in config-available.seed.
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usbmon=y
CONFIG_PACKAGE_unzip=y

CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_earlyoom=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_gkermit=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_tcpdump=y

# Pinned mwan3 forks; build_me.pl rsyncs them over feeds/packages.
CONFIG_PACKAGE_luci-app-mwan3=y

CONFIG_BUSYBOX_CONFIG_BLKDISCARD=y
CONFIG_BUSYBOX_CONFIG_BLOCKDEV=y
CONFIG_BUSYBOX_CONFIG_CHRT=y
# luci-app-airoha-npu is vendored and can't DEPENDS on this; also needs
# CONFIG_KERNEL_DEVMEM (target-airoha-an7581.seed).
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_FDISK=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_SIGNAL_HANDLING=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_STATUS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_THIRD_STATUS_LINE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_FDISK_ADVANCED=y
CONFIG_BUSYBOX_CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_GPT_LABEL=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_GET_IDENTITY=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_HDIO_DRIVE_RESET=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_HDIO_GETSET_DMA=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_HDIO_SCAN_HWIF=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_HDIO_TRISTATE_HWIF=y
CONFIG_BUSYBOX_CONFIG_FEATURE_HDPARM_HDIO_UNREGISTER_HWIF=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_BRACKETS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_DASHCMD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_MARKS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_TRUNCATE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_WINCH=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_OTHERTAB=y
CONFIG_BUSYBOX_CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TASKSET_CPULIST=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TASKSET_FANCY=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_BTRFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_EXFAT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_F2FS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_HFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_ISO9660=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LINUXRAID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LINUXSWAP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LUKS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_NTFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_SQUASHFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_UBIFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_XFS=y
CONFIG_BUSYBOX_CONFIG_FSTRIM=y
CONFIG_BUSYBOX_CONFIG_HDPARM=y
# luci-app-h5000m-fancontrol is vendored and can't DEPENDS on this.
CONFIG_BUSYBOX_CONFIG_HEXDUMP=y
CONFIG_BUSYBOX_CONFIG_HEXEDIT=y
CONFIG_BUSYBOX_CONFIG_IONICE=y
CONFIG_BUSYBOX_CONFIG_IOSTAT=y
CONFIG_BUSYBOX_CONFIG_LSOF=y
CONFIG_BUSYBOX_CONFIG_NC_110_COMPAT=y
CONFIG_BUSYBOX_CONFIG_NC_EXTRA=y
CONFIG_BUSYBOX_CONFIG_NC_SERVER=y
CONFIG_BUSYBOX_CONFIG_NETCAT=y
CONFIG_BUSYBOX_CONFIG_PKILL=y
CONFIG_BUSYBOX_CONFIG_RENICE=y
CONFIG_BUSYBOX_CONFIG_SENDMAIL=y
CONFIG_BUSYBOX_CONFIG_STTY=y
CONFIG_BUSYBOX_CONFIG_TASKSET=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
CONFIG_BUSYBOX_CONFIG_WATCH=y
