# Customization of build config for Airoha

CONFIG_TARGET_airoha=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_VERSION_MANUFACTURER_URL="https://www.airoha.com/"
CONFIG_VERSION_MANUFACTURER="Airoha"
CONFIG_VERSION_PRODUCT="Airoha"

# Unlike mediatek/ramips, airoha's DEFAULT_PACKAGES ships no wpad to undo.
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_wpad-mbedtls=y
