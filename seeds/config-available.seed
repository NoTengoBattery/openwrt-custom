# SCOPE: all targets, all size tiers        LEVEL: =m only
#
# Packages built and published to the package repository for post-install,
# but never baked into an image. Anything that must be present at boot
# belongs in config-features.seed (=y) instead.
#
# A later seed may promote any of these to =y for one target; see README.md.

CONFIG_PACKAGE_6rd=m
CONFIG_PACKAGE_libopenssl-afalg=m
CONFIG_PACKAGE_libopenssl-afalg_sync=m
CONFIG_PACKAGE_libopenssl-devcrypto=m
# Its self-conditional perl deps make a DEPENDS on this recursive to kconfig
# (silently deselects the depending package). packages-full.seed -> =y.
CONFIG_PACKAGE_lm-sensors-detect=m
# Load-bearing for the ipq40xx Linksys DEVICE_PACKAGES lines (dual-partition).
CONFIG_PACKAGE_luci-app-advanced-reboot=m
CONFIG_PACKAGE_luci-app-nlbwmon=m
CONFIG_PACKAGE_luci-app-samba4=m
# =m only publishes them; the W1700K DEVICE_PACKAGES line in
# target-airoha-an7581.seed bakes them into the AP rootfs — without these
# lines that line silently resolves to nothing.
CONFIG_PACKAGE_luci-app-airoha-flowsense=m
CONFIG_PACKAGE_luci-app-airoha-npu=m
CONFIG_PACKAGE_luci-app-airoha-recovery=m
CONFIG_PACKAGE_luci-app-mlo=m
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=m
CONFIG_PACKAGE_luci-app-wifi7=m
CONFIG_PACKAGE_minidlna=m
# =m only publishes it; the DEVICE_PACKAGES lines in the target seeds bake it
# into the AP rootfs — without this line those lines silently resolve to nothing.
CONFIG_PACKAGE_python3=m

# notengobattery-defaults already stages its config, so this just works.
CONFIG_PACKAGE_unbound-daemon=m
