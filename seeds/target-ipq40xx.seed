# Customization of build config for IPQ40xx

CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a7"
CONFIG_KERNEL_CFLAGS="-pipe -mtune=cortex-a7"

CONFIG_VERSION_MANUFACTURER_URL="https://www.qualcomm.com/"
CONFIG_VERSION_MANUFACTURER="Qualcomm"
CONFIG_VERSION_PRODUCT="IPQ40xx"

# target/linux/ipq40xx/Makefile ships wpad-basic-mbedtls; opt out explicitly.
# Watch the mikrotik image size (16 MB flash) if this grows.
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mbedtls=y
