# Customization of kernel config for Airoha (AN7581)

CONFIG_CMDLINE=""

# No AN7581 board built here has an audio codec, and the afe node is disabled
# in an7581.dtsi. Leaving this on exposes SND_SOC_AN7581_WM8960 (depends on
# I2C) only once a kmod enables I2C, which is after kernel_oldconfig has run.
# CONFIG_SND_SOC_AN7581 is not set

CONFIG_DEFAULT_HOSTNAME="AN7581"

# Built-in so THERMAL_HWMON can bridge the SoC thermal zone into lm-sensors;
# as a module (kmod-hwmon-core) the bridge is unavailable. Mirrors filogic.
CONFIG_HWMON=y
CONFIG_THERMAL_HWMON=y
