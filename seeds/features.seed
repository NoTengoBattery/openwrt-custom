# Build this packages so they are available for installation

CONFIG_AFALG_DIGESTS=y
CONFIG_AFALG_FALLBACK=y
CONFIG_AFALG_UPDATE_CTR_IV=y
CONFIG_AFALG_ZERO_COPY=y

CONFIG_KERNEL_BTRFS_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_F2FS_FS_POSIX_ACL=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_TASKSTATS=y
CONFIG_KERNEL_XFS_POSIX_ACL=y

CONFIG_USE_FS_ACL_ATTR=y

CONFIG_RSYNC_acl=y
CONFIG_RSYNC_xattr=y
CONFIG_RSYNC_zstd=y

CONFIG_PACKAGE_6rd=m
CONFIG_PACKAGE_libopenssl-afalg_sync=m
CONFIG_PACKAGE_libopenssl-afalg=m
CONFIG_PACKAGE_libopenssl-devcrypto=m
CONFIG_PACKAGE_luci-app-advanced-reboot=m
CONFIG_PACKAGE_luci-app-mwan3=m
CONFIG_PACKAGE_luci-app-nlbwmon=m
CONFIG_PACKAGE_luci-app-samba4=m
CONFIG_PACKAGE_luci-proto-qmi=m
CONFIG_PACKAGE_minidlna=m

CONFIG_BUSYBOX_CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_CP_REFLINK=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_STATUS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_DD_THIRD_STATUS_LINE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_BCACHE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_BTRFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_CRAMFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_EROFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_EXFAT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_F2FS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_HFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_ISO9660=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_JFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LINUXRAID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LINUXSWAP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_LUKS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_MINIX=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_NILFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_NTFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_OCFS2=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_REISERFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_ROMFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_SQUASHFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_SYSV=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_UBIFS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_UDF=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VOLUMEID_XFS=y
