# SCOPE: all targets, PKGS=full only        LEVEL: =y
#
# The wide storage tier. kmod-fs-ext4, kmod-fs-vfat and dosfstools are in
# config-features.seed instead, so a slim image can still mount a USB
# stick; kmod-fs-exfat arrives via the notengobattery-defaults DEPENDS.
# See README.md.

CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-hfs=y
CONFIG_PACKAGE_kmod-fs-hfsplus=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fuse=y

CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_fio=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_lm-sensors-detect=y
CONFIG_PACKAGE_nfdump=y
CONFIG_PACKAGE_smartd=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_softflowd=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_udp-broadcast-relay-redux=y

CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y

# btrfs-snapshots is useless without kmod-fs-btrfs above; move as one group.
CONFIG_BTRFS_PROGS_ZSTD=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_btrfs-snapshots=y

CONFIG_PACKAGE_cryptsetup=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_xfs-admin=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-growfs=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_zstd=y

CONFIG_KERNEL_BTRFS_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_F2FS_FS_POSIX_ACL=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_HFS_FS_POSIX_ACL=y
CONFIG_KERNEL_HFSPLUS_FS_POSIX_ACL=y
CONFIG_KERNEL_TMPFS_POSIX_ACL=y
CONFIG_KERNEL_XFS_POSIX_ACL=y
CONFIG_USE_FS_ACL_ATTR=y
