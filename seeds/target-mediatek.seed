# Customization of build config for Mediatek

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_VERSION_MANUFACTURER_URL="https://www.mediatek.com/"
CONFIG_VERSION_MANUFACTURER="Mediatek"
CONFIG_VERSION_PRODUCT="Mediatek"

# Wireless stack for this SoC family. The subtargets ship
# wpad-basic-mbedtls in DEFAULT_PACKAGES, so it needs an explicit opt-out.
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mbedtls=y
