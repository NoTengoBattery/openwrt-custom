# Customization of build config for Mediatek (Filogic)

CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_KERNEL_CFLAGS="-pipe -march=armv8-a -mtune=cortex-a53"

# All supported devices
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_hiveton_h5000m=y

# The H5000M fan controller is per-device: Device/hiveton_h5000m
# DEVICE_PACKAGES in image/filogic.mk.
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_hiveton_h5000m="python3"

# The wireless stack and mwan3 are declared at family and cross-target
# scope respectively; see target-mediatek.seed and config-features.seed.

# Cellular modem suite promoted from config-available.seed (=m).
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_luci-app-modemdata=y
CONFIG_PACKAGE_luci-app-qfirehose=y
CONFIG_PACKAGE_luci-app-sms-manager=y
CONFIG_PACKAGE_luci-proto-qmi=y
