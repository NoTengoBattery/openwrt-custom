# Customization of kernel config for Intel (x86)

CONFIG_CMDLINE=""

CONFIG_CRYPTO_AEGIS128_AESNI_SSE2=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_BLAKE2S_X86=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_CURVE25519_X86=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
CONFIG_CRYPTO_NHPOLY1305_AVX2=y
CONFIG_CRYPTO_NHPOLY1305_SSE2=y
CONFIG_CRYPTO_SERPENT_SSE2_586=y
CONFIG_CRYPTO_SHA1_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_ENERGY_MODEL=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_INTEL_RAPL=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_NEVER=n
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_MCE_INTEL=y

# intel_pstate (active mode) offers only performance and powersave;
# non-default choice, so it survives the regen's minimize-to-default pass.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=n
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y

CONFIG_FRAME_WARN=1024

CONFIG_DEFAULT_HOSTNAME="x86"
