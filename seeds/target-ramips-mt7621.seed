# Customization of build config for RAMIPS (MT7621)

CONFIG_KERNEL_CFLAGS="-pipe -mno-branch-likely -mips32r2 -mtune=1004kc"
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=n
CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mno-branch-likely -march=1004kc -mtune=1004kc"
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
CONFIG_SQUASHFS_ZSTD=n

CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_asus_rt-ax53u=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_zbtlink_zbt-wg3526-16m=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_zbtlink_zbt-wg3526-32m=y

CONFIG_VERSION_MANUFACTURER_URL="https://www.mediatek.com"
CONFIG_VERSION_MANUFACTURER="MediaTek"
CONFIG_VERSION_PRODUCT="MT7621"

# Packages for every specific MT7621 devices
# Cellular modem suite: the wg3526 is a CPE host.
CONFIG_TARGET_DEVICE_PACKAGES_ramips_mt7621_DEVICE_zbtlink_zbt-wg3526-16m="kmod-usb-net-cdc-mbim luci-app-modemdata luci-app-qfirehose luci-app-sms-manager luci-proto-qmi"
CONFIG_TARGET_DEVICE_PACKAGES_ramips_mt7621_DEVICE_zbtlink_zbt-wg3526-32m="kmod-usb-net-cdc-mbim luci-app-modemdata luci-app-qfirehose luci-app-sms-manager luci-proto-qmi"

# The wireless stack and mwan3 are declared at family and cross-target
# scope respectively; see target-ramips.seed and config-features.seed.
