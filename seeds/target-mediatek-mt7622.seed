# Customization of build config for Mediatek (MT7622)

CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_KERNEL_CFLAGS="-pipe -march=armv8-a -mtune=cortex-a53"

# All supported devices
CONFIG_TARGET_DEVICE_mediatek_mt7622_DEVICE_netgear_wax206=y

# Packages for every specific MT7622


# The wireless stack and mwan3 are declared at family and cross-target
# scope respectively; see target-mediatek.seed and config-features.seed.
